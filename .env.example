# Required: the app refuses to start without it.
REDIS_URL=redis://localhost:6379

PORT=3000

# development or test enables the "simulate" request field (forced failures); anything else rejects it.
NODE_ENV=development

# Number of proxies (load balancers) in front of the app, so rate limits apply per real client IP.
TRUST_PROXY_HOPS=0

# Worker tuning (defaults shown).
WORKER_CONCURRENCY=5
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=1000
